---
import { Icon } from "astro-icon/components";

type Card = {
  icon: string;
  title: string;
  text?: string;
  points?: string[];
};

interface Props {
  items: Card[];
  columns?: 2 | 3 | 4;
}

const { items, columns = 2 } = Astro.props;

// Literal class names so Tailwind can detect them
const columnClasses = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-2 md:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
};
---

<div class:list={["not-prose my-8 grid grid-cols-1 gap-4", columnClasses[columns]]}>
  {
    items.map((item) => (
      <div class="flex flex-col gap-3 rounded-xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-700 dark:bg-zinc-800/60">
        <div class="flex size-11 items-center justify-center rounded-lg bg-rose-100 text-rose-700 dark:bg-rose-500/15 dark:text-rose-300">
          <Icon name={item.icon} class="size-6" />
        </div>
        <div class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">
          {item.title}
        </div>
        {item.text && (
          <div class="text-base leading-relaxed text-zinc-600 dark:text-zinc-300">
            {item.text}
          </div>
        )}
        {item.points && (
          <ul class="m-0 flex list-disc flex-col gap-1.5 pl-5 text-base leading-snug text-zinc-600 dark:text-zinc-300">
            {item.points.map((point) => (
              <li set:html={point} />
            ))}
          </ul>
        )}
      </div>
    ))
  }
</div>
