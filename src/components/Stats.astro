---
type Stat = {
  value: string;
  label: string;
  source?: string;
};

interface Props {
  items: Stat[];
}

const { items } = Astro.props;
---

<div class="not-prose my-8 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
  {
    items.map((item) => (
      <div class="flex flex-col gap-2 rounded-xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-700 dark:bg-zinc-800/60">
        <div class="text-3xl font-semibold tracking-tight text-rose-700 tabular-nums dark:text-rose-300">
          {item.value}
        </div>
        <div class="text-base leading-snug text-zinc-700 dark:text-zinc-300">
          {item.label}
        </div>
        {item.source && (
          <div class="mt-auto text-xs tracking-wide text-zinc-500 uppercase dark:text-zinc-400">
            {item.source}
          </div>
        )}
      </div>
    ))
  }
</div>
