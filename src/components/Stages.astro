---
import { Icon } from "astro-icon/components";

type Stage = {
  title: string;
  actor: string;
  icon: string;
  color: "blue" | "green" | "amber";
  steps: string[];
};

interface Props {
  items: Stage[];
}

const { items } = Astro.props;

// Match the stage colours of the architecture diagram. Literal class names so
// Tailwind can detect them.
const colorClasses = {
  blue: {
    card: "border-blue-200 bg-blue-50 dark:border-blue-400/30 dark:bg-blue-500/10",
    badge: "bg-blue-600 text-white dark:bg-blue-400 dark:text-blue-950",
  },
  green: {
    card: "border-green-200 bg-green-50 dark:border-green-400/30 dark:bg-green-500/10",
    badge: "bg-green-600 text-white dark:bg-green-400 dark:text-green-950",
  },
  amber: {
    card: "border-amber-200 bg-amber-50 dark:border-amber-400/30 dark:bg-amber-500/10",
    badge: "bg-amber-500 text-white dark:bg-amber-400 dark:text-amber-950",
  },
};
---

<ol class="not-prose my-8 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-3">
  {
    items.map((item, index) => (
      <li
        class:list={[
          "flex flex-col gap-3 rounded-xl border p-5",
          colorClasses[item.color].card,
        ]}
      >
        <div class="flex items-center justify-between gap-2">
          <span
            class:list={[
              "shrink-0 rounded-full px-3 py-0.5 text-xs font-semibold tracking-wider whitespace-nowrap uppercase",
              colorClasses[item.color].badge,
            ]}
          >
            Stage {index + 1}
          </span>
          <span class="flex items-center gap-1.5 text-right text-sm leading-tight text-zinc-600 dark:text-zinc-300">
            <Icon name={item.icon} class="size-5" />
            {item.actor}
          </span>
        </div>
        <div class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">
          {item.title}
        </div>
        <ul class="m-0 flex list-disc flex-col gap-1.5 pl-5 text-base leading-snug text-zinc-700 dark:text-zinc-300">
          {item.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>
