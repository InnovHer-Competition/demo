---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  icon?: string;
  aspectRatio?: number;
}

const { title, icon = "ri:time-line", aspectRatio = 16 / 9 } = Astro.props;
---

<div
  class="not-prose flex w-full flex-col items-center justify-center gap-3 rounded-lg border-2 border-dashed border-zinc-300 bg-zinc-50 p-8 text-center text-zinc-500 dark:border-zinc-700 dark:bg-zinc-800/50 dark:text-zinc-400"
>
  <Icon name={icon} class="size-10" />
  <div class="text-xl font-medium text-zinc-700 dark:text-zinc-200">
    {title}
  </div>
  <div class="max-w-md text-base"><slot>Coming soon.</slot></div>
</div>

<style define:vars={{ aspectRatio }}>
  div:first-of-type {
    aspect-ratio: var(--aspectRatio);
  }
</style>
